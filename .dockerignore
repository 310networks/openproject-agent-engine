# Never ship operator state or secrets into the image.
.git
.gitignore
docker/config
.env
docker/.env
/*.bak.*

# Agent working copies are cloned at runtime into a volume.
agents/*/repositories

# Development and runtime leftovers.
.venv
venv
__pycache__
*.py[cod]
*.egg-info
build
dist
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
*.sqlite3
*.sqlite3-*
*.log
*.swp

# Not needed to build or run the engine.
.github
tests
docs
*.md
!README.md
docker-compose*.yml

# Keep the pieces the image actually copies.
!prompts
!agents
