# op-agent-engine environment
#
# Copy to .env next to docker-compose.yml (mode 0600) and fill it in, or let
# ./provision-users.sh prompt you, create the OpenProject users and write the
# tokens here. Compose reads this file automatically; it is never mounted.
# Never commit the real file: it contains API tokens.

# --- OpenProject (required) -------------------------------------------------

OP_BASE_URL=https://openproject.example.com
# Identifier of the OpenProject project the engine works on.
OP_PROJECT=my-project
# API token of the engine user; make that user an administrator.
OP_ENGINE_TOKEN=replace-with-agent-engine-api-token

# --- The repository work packages are implemented in (required) -------------

GITHUB_REPO=owner/repository
# Clone directory under WORKSPACE_ROOT (default: the repository name).
# GITHUB_REPO_DIR=repository
# GITHUB_DEFAULT_BRANCH=main

# --- Agent CLI and tokens (required) ---------------------------------------

# pi or opencode.
AGENT=pi
# Optional model for every agent, e.g. anthropic/claude-sonnet-4-5.
# AGENT_MODEL=

OP_TOKEN_FRONTEND=replace-with-frontend-api-token
OP_TOKEN_BACKEND=replace-with-backend-api-token
OP_TOKEN_DESIGNER=replace-with-designer-api-token
OP_TOKEN_REVIEWER=replace-with-reviewer-api-token

# --- Provisioning (only ./provision-users.sh and `provision`) --------------

# An administrator token used to create users and memberships. The script asks
# for it on each run and does not store it.
# OP_PROVISION_TOKEN=

# --- OpenProject object names (defaults match a stock instance) ------------

# OP_AGENT_FIELD=AGENT
# OP_ENGINE_USER=agent-engine
# OP_AGENT_ROLE=Agent Worker
# OP_EMAIL_DOMAIN=agent-engine.local
# OP_STATUS_NEW=New
# OP_STATUS_IN_PROGRESS=In Progress
# OP_STATUS_READY_FOR_REVIEW=Ready for Review
# OP_STATUS_IN_TESTING=In Testing
# OP_STATUS_ON_HOLD=On Hold
# OP_STATUS_REJECTED=Rejected
# OP_STATUS_CLOSED=Closed

# --- Limits and timing ------------------------------------------------------

POLL_INTERVAL_SECONDS=60
MAX_CONCURRENT_RUNS=1
MAX_REJECTIONS=3
MAX_CRASH_RETRIES=2
RUN_TIMEOUT_SECONDS=3600
AGENT_TIMEOUT_SECONDS=3600
STOP_GRACE_SECONDS=60
# Run directories older than this are removed by `docker compose run --rm cleanup`
# (nothing schedules it; add a cron entry on the host, see the README).
RUN_RETENTION_DAYS=30
ENGINE_PAUSED=false
LOG_LEVEL=INFO

# --- Dashboard --------------------------------------------------------------
# Read-only web UI, served by the `dashboard` compose service and published on
# 127.0.0.1 only (DASHBOARD_BIND). Change the host only behind a reverse proxy:
# the dashboard has no authentication.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765

# --- Optional ---------------------------------------------------------------
# GH_TOKEN gives the agents a GitHub credential; without it, pushes need another
# one (a git credential helper cannot see the host's keyring from a container).
# GH_TOKEN=

# Read by compose, not by the engine:
# OP_AGENT_ENGINE_TAG=latest
# DASHBOARD_BIND=127.0.0.1
