# env
.env
# operator files created from the examples before running install.sh
/workflow.yaml
/engine.env
/*.bak.*
# staged container configuration: only the empty skeleton is committed.
# Everything else in here is a copy of the operator's credentials, settings,
# skills and git identity, so it must never reach the repository.
/config/*
!/config/.gitkeep
!/config/pi
/config/pi/*
!/config/pi/.gitkeep
!/config/pi/skills
/config/pi/skills/*
!/config/pi/skills/.gitkeep
# agent working repos
agents/*/repositories/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# runtime data
*.sqlite3
*.sqlite3-*
engine.lock
heartbeat

# editor swap files
*.swp
