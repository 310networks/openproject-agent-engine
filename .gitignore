# env
.env
# operator files created from the examples before running install.sh
/workflow.yaml
/engine.env
/*.bak.*
# Operator configuration. The templates that contain nothing personal
# (gitconfig, pi/settings.json, pi/auth.json, opencode/opencode.json) are
# committed so they can be edited in place; everything that holds a real secret
# or your own content stays out of git:
#   engine.env            real API tokens
#   workflow.yaml         your projects, repositories and agents
#   pi/skills/**          your skills
#   opencode/auth.json    real provider credentials
#   anything else you add
/docker/config/*
!/docker/config/gitconfig
!/docker/config/pi
/docker/config/pi/*
!/docker/config/pi/auth.json
!/docker/config/pi/settings.json
!/docker/config/pi/skills
/docker/config/pi/skills/*
!/docker/config/pi/skills/.gitkeep
!/docker/config/opencode
/docker/config/opencode/*
!/docker/config/opencode/opencode.json
/docker/provision-tmp.*
# agent working repos
agents/*/repositories/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# runtime data
*.sqlite3
*.sqlite3-*
engine.lock
heartbeat

# editor swap files
*.swp
