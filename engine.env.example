# op-agent-engine environment file
# Copy to docker/config/engine.env (mode 0600), edit it, then run
# ./docker/provision-users.sh. It is read by compose on the host and passed to
# the container as environment variables, so it is never mounted.
# Never commit the real file: it contains API tokens.

# --- OpenProject (required) -------------------------------------------------

OP_BASE_URL=https://openproject.example.com
OP_PROVISION_TOKEN=replace-with-openproject-admin-token


OP_ENGINE_TOKEN=replace-with-agent-engine-api-token

# Which agent CLI the agents run with: `pi` or `opencode`.
# workflow.yaml uses it as the runner for every agent (runner: "${AGENT}"), so
# switching is a single line here instead of four edits there.
AGENT=pi

# Per-agent tokens referenced from workflow.yaml as ${OP_TOKEN_*}. The OpenProject
# CLI reads them through OP_CLI_HOST / OP_CLI_TOKEN (set in workflow.yaml).
OP_TOKEN_FRONTEND=replace-with-frontend-api-token
OP_TOKEN_BACKEND=replace-with-backend-api-token
OP_TOKEN_DESIGNER=replace-with-designer-api-token
OP_TOKEN_REVIEWER=replace-with-reviewer-api-token

# --- Engine paths -----------------------------------------------------------
# The image sets these to the container's own volumes, so they normally do not
# belong here at all; uncomment only to point them somewhere else.
# WORKSPACE_ROOT=/home/agent/agents
# ENGINE_CONFIG=/config/workflow.yaml
# DATA_DIR=/home/agent/.local/share/op-agent-engine

# --- Limits and timing ------------------------------------------------------
POLL_INTERVAL_SECONDS=60
MAX_CONCURRENT_RUNS=1
MAX_REJECTIONS=3
MAX_CRASH_RETRIES=2
RUN_TIMEOUT_SECONDS=3600
STOP_GRACE_SECONDS=60
# Run directories older than this are removed by `docker compose run --rm cleanup`
# (nothing schedules it; add a cron entry on the host, see the README).
RUN_RETENTION_DAYS=30
ENGINE_PAUSED=false
LOG_LEVEL=INFO

# --- Dashboard --------------------------------------------------------------
# Read-only web UI, served by the `dashboard` compose service and published on
# 127.0.0.1 only (DASHBOARD_BIND). Change the host only behind a reverse proxy:
# the dashboard has no authentication.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765

# --- Optional ---------------------------------------------------------------
# GH_TOKEN gives the agents a GitHub credential; without it, pushes need another
# one (a git credential helper cannot see the host's keyring from a container).
# GH_TOKEN=
