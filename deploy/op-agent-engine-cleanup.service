[Unit]
Description=OpenProject Agent Engine run-directory retention
Documentation=file://<home>/op-agent-engine/README.md
# The cleanup only touches DATA_DIR/runs; it does not need the engine running.
After=op-agent-engine.service

[Service]
Type=oneshot
User=<user>
Group=<user>
WorkingDirectory=<home>
EnvironmentFile=<home>/.config/op-agent-engine/engine.env
ExecStart=<exe> cleanup
Nice=10
