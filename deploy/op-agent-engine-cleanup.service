[Unit]
Description=OpenProject Agent Engine run-directory retention
Documentation=file:///home/<host-user>/op-agent-engine/README.md
# The cleanup only touches DATA_DIR/runs; it does not need the engine running.
After=op-agent-engine.service

[Service]
Type=oneshot
User=<host-user>
Group=<host-user>
WorkingDirectory=/home/<host-user>
EnvironmentFile=/home/<host-user>/.config/op-agent-engine/engine.env
ExecStart=/home/<host-user>/.local/share/op-agent-engine/venv/bin/op-agent-engine cleanup
Nice=10
