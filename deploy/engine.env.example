# op-agent-engine environment file
# Install as ~/.config/op-agent-engine/engine.env, mode 0600.
# Never commit the real file: it contains API tokens.

# --- OpenProject (required) -------------------------------------------------
OP_BASE_URL=https://openproject.example.com
OP_ENGINE_TOKEN=replace-with-agent-engine-api-token

# Per-agent tokens referenced from workflow.yaml as ${OP_TOKEN_*}. The OpenProject
# CLI reads them through OP_CLI_HOST / OP_CLI_TOKEN (set in workflow.yaml).
OP_TOKEN_FRONTEND=replace-with-frontend-api-token
OP_TOKEN_BACKEND=replace-with-backend-api-token
OP_TOKEN_DESIGNER=replace-with-designer-api-token
OP_TOKEN_REVIEWER=replace-with-reviewer-api-token

# --- Engine paths -----------------------------------------------------------
# Absolute path to the agents/ directory of the engine checkout the service runs from.
WORKSPACE_ROOT=/home/<host-user>/op-agent-engine/agents
ENGINE_CONFIG=/home/<host-user>/.config/op-agent-engine/workflow.yaml
DATA_DIR=/home/<host-user>/.local/share/op-agent-engine

# --- Limits and timing ------------------------------------------------------
POLL_INTERVAL_SECONDS=60
MAX_CONCURRENT_RUNS=1
MAX_REJECTIONS=3
MAX_CRASH_RETRIES=2
RUN_TIMEOUT_SECONDS=3600
STOP_GRACE_SECONDS=60
ENGINE_PAUSED=false
LOG_LEVEL=INFO

# --- Optional ---------------------------------------------------------------
# GH_TOKEN overrides the host's existing gh and git authentication.
# Normally unset: agents use the host user's gh keyring credentials.
# GH_TOKEN=
