[Unit]
Description=OpenProject Agent Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Optional systemd watchdog: switch to Type=notify and set WatchdogSec to three
# poll intervals (for example 180 with the default 60s poll). The engine sends
# READY=1 after startup resolution and WATCHDOG=1 after every poll when
# NOTIFY_SOCKET is set.
#Type=notify
#WatchdogSec=180
User=<host-user>
Group=<host-user>
WorkingDirectory=/home/<host-user>
EnvironmentFile=/home/<host-user>/.config/op-agent-engine/engine.env
# Must include the directories of every agent CLI (pi, opencode, gh, git, node).
# Verified CLI locations on the reference host: pi -> ~/.pi/agent/bin,
# opencode -> ~/.opencode/bin. Add a Node version manager bin directory here if
# the agent CLIs are installed that way; systemd does not read shell profiles.
Environment=PATH=/home/<host-user>/.local/bin:/home/<host-user>/.pi/agent/bin:/home/<host-user>/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/<host-user>/.local/share/op-agent-engine/venv/bin/op-agent-engine run --config /home/<host-user>/.config/op-agent-engine/workflow.yaml
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=90
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
